// Spectators may read the live race and its laps. Browsers can never write:
// every change goes through the raceOp Cloud Function, which checks the PIN,
// validates the change and records it in the audit log.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /races/main {
      allow read: if true;
      allow write: if false;
      match /laps/{lapId} {
        allow read: if true;
        allow write: if false;
      }
    }
    // Last year's record, read once to import its teams.
    match /raceSnapshots/main {
      allow read: if true;
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
