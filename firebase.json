{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22",
    "ignore": ["node_modules", "test", ".secret.local", "*.log"]
  },
  "hosting": {
    "public": "web/dist",
    "predeploy": ["npm --prefix web run build"],
    "ignore": ["**/*.map", "**/.*"],
    "rewrites": [
      { "source": "/api/time", "function": { "functionId": "time", "region": "asia-south1" } },
      { "source": "**", "destination": "/index.html" }
    ],
    "headers": [
      { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/assets/**", "headers": [{ "key": "Cache-Control", "value": "public,max-age=31536000,immutable" }] },
      { "source": "/fonts/**", "headers": [{ "key": "Cache-Control", "value": "public,max-age=604800" }] },
      { "source": "**", "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ] }
    ]
  },
  "emulators": {
    "functions": { "port": 5001 },
    "firestore": { "port": 8080 },
    "hosting": { "port": 5050 },
    "ui": { "enabled": false },
    "singleProjectMode": true
  }
}
